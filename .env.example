# DepthWizard backend configuration.
# Copy to .env and fill in local paths. Never commit the real .env.

# --- Model weights (local paths; see ml/ for vendored source) ---
DEPTH_ANYTHING_V2_ENCODER=vitb
# GAMUS-fine-tuned checkpoint (ml/training/finetune_da_v2_full.py) -- measured improvement over the
# stock pretrained weights on held-out remote-sensing AGL-height data; see context/research-notes.md.
# Use ./ml/depth_anything_v2_vitb.pth for the original pretrained checkpoint instead.
DEPTH_ANYTHING_V2_CHECKPOINT=./ml/depth_anything_v2_vitb_gamus_best.pth
DEPTH_PRO_CHECKPOINT=./ml/ml-depth-pro-main/checkpoints/depth_pro.pt

# --- Device / precision ---
# cuda | cpu
DEVICE=cuda
# DA V2 has no fp16 issues observed; Depth Pro is run at fp16 on CUDA.
DEPTH_PRO_PRECISION=float16
# Depth Pro is reference output only (anti-correlated with height on nadir imagery); false = ~60% faster.
ENABLE_DEPTH_PRO=false
# Fine-tuned DA V2 output -> approximate metres (empirical GAMUS median; not a per-image calibration).
DA_V2_HEIGHT_SCALE=2.6

# --- Reference elevation data (for GeoTIFF calibration) ---
# Directory containing SRTM 30m (or other DEM) tiles usable for calibration.
SRTM_DATA_DIR=./data/reference

# --- Storage ---
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs

# --- API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API (the Next.js dev server by default).
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Height calibration / DEM ---
# Download the missing SRTM 1-arcsec tile (public AWS terrain tiles) for georeferenced input.
# Set false for air-gapped installs and pre-seed SRTM_DATA_DIR instead.
DEM_AUTO_DOWNLOAD=true

# --- Auth (optional). When false every request is treated as a local analyst. ---
AUTH_REQUIRED=false
AUTH_SECRET=change-me

# --- AI analyst + scene chat (optional, network-gated). Only derived statistics are ever sent. ---
# Any OpenAI-compatible endpoint. Leave the key empty and both the brief and the scene chat fall
# back to the offline template analyst, which answers from the same computed statistics.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Aerial object detection (FR-50) ---
# Oriented-box detector trained on DOTA (aerial imagery). COCO-trained weights hit the same nadir
# domain gap the depth backbones do -- measured on one GAMUS tile: 6 detections (plus "refrigerator"
# and "tv" labels) vs 300 correctly-oriented vehicles from the DOTA model.
# Fetch the weights once:  python -c "from ultralytics import YOLO; YOLO('yolov8s-obb.pt')"
# then move yolov8s-obb.pt to ml/yolo/.
ENABLE_OBJECT_DETECTION=true
OBJECT_DETECTION_WEIGHTS=./ml/yolo/yolov8s-obb.pt
OBJECT_DETECTION_CONF=0.3
OBJECT_DETECTION_IMGSZ=1024
